<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Visible status. For apparel its severity mirrors the single outermost
       damaged armor layer. It has no stat effect of its own. -->
  <HediffDef>
    <defName>AI_BatteredArmor</defName>
    <label>battered armor</label>
    <description>The currently visible armor layer has lost part of its protective integrity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1.0</maxSeverity>
    <makesAlert>false</makesAlert>
    <displayWound>true</displayWound>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <comps>
      <li Class="ArmorIntegrity.HediffCompProperties_ArmorDisplaySync" />
    </comps>
  </HediffDef>

  <!-- Persistent condition storage for natural, gene and implant armor. -->
  <HediffDef>
    <defName>AI_IntrinsicArmorWear</defName>
    <label>intrinsic armor wear</label>
    <description>Internal Armor Integrity state for temporarily exhausted intrinsic armor.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1.0</maxSeverity>
    <makesAlert>false</makesAlert>
    <displayWound>false</displayWound>
    <alwaysShowSeverity>false</alwaysShowSeverity>
    <comps>
      <li Class="ArmorIntegrity.HediffCompProperties_ArmorRecovery" />
    </comps>
  </HediffDef>

  <!-- Save-compatibility only for old Armored Up saves. Armor Integrity never
       reads this severity as its own armor state. -->
  <HediffDef>
    <defName>BatteredArmor</defName>
    <label>battered armor</label>
    <description>Legacy Armored Up state retained only so old saves can load safely.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1.0</maxSeverity>
    <makesAlert>false</makesAlert>
    <displayWound>false</displayWound>
    <alwaysShowSeverity>false</alwaysShowSeverity>
    <comps>
      <li Class="ArmorIntegrity.HediffCompProperties_ArmorRecovery" />
    </comps>
  </HediffDef>
</Defs>
